DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Firebase — download service account JSON from:
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=   # alternative: paste base64 JSON here (for Cloud Run)

# GCS bucket for uploaded documents (plain bucket, not the reserved *.firebasestorage.app domain)
FIREBASE_STORAGE_BUCKET=jobs-e038b-documents
